# Optional LLM functionality. Without a key, app continues in labelled rule mode.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_PROVIDER=openai
# For Zhipu: AI_PROVIDER=zhipu and ZHIPU_API_KEY=your-key.
# Zhipu always uses glm-4.7-flash; AI_MODEL only applies to OpenAI.
ZHIPU_API_KEY=
# Only fixed official provider endpoints; .env is not auto-loaded.
